<script>
  console.log('ivy-review-js loaded');

  function openIvyReviewsModal() {
    console.log('openIvyReviewsModal fired');
    var modal = document.getElementById('ivy-reviews-modal');
    if (!modal) {
      console.log('modal not found');
      return;
    }
    modal.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }

  function closeIvyReviewsModal() {
    console.log('closeIvyReviewsModal fired');
    var modal = document.getElementById('ivy-reviews-modal');
    if (!modal) return;
    modal.classList.remove('is-open');
    document.body.style.overflow = '';
  }

  window.openIvyReviewsModal = openIvyReviewsModal;
  window.closeIvyReviewsModal = closeIvyReviewsModal;

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeIvyReviewsModal();
    }
  });

  document.addEventListener('click', function(e) {
    var badge = e.target.closest('.romw-review-panel');
    if (!badge) return;

    console.log('badge clicked');
    console.log('badge href before:', badge.getAttribute('href'));
    console.log('badge target before:', badge.getAttribute('target'));

    e.preventDefault();
    e.stopPropagation();
    if (e.stopImmediatePropagation) e.stopImmediatePropagation();

    badge.removeAttribute('target');
    badge.removeAttribute('rel');
    badge.setAttribute('href', 'javascript:void(0)');

    openIvyReviewsModal();

    return false;
  }, true);
</script>