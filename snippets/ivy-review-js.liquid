<script>
  console.log('ivy-review-js loaded');

  function openIvyReviewsModal() {
    var modal = document.getElementById('ivy-reviews-modal');
    if (!modal) return;
    modal.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }

  function closeIvyReviewsModal() {
    var modal = document.getElementById('ivy-reviews-modal');
    if (!modal) return;
    modal.classList.remove('is-open');
    document.body.style.overflow = '';
  }

  window.openIvyReviewsModal = openIvyReviewsModal;
  window.closeIvyReviewsModal = closeIvyReviewsModal;

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeIvyReviewsModal();
  });

  function getBadgeFromEventTarget(target) {
    return target.closest('#romw_floating_badge_widget .romw-review-panel');
  }

  function interceptBadge(e) {
    var badge = getBadgeFromEventTarget(e.target);
    if (!badge) return;

    console.log('badge interaction intercepted:', e.type);

    e.preventDefault();
    e.stopPropagation();
    if (e.stopImmediatePropagation) e.stopImmediatePropagation();

    openIvyReviewsModal();
    return false;
  }

  document.addEventListener('click', interceptBadge, true);
  document.addEventListener('pointerup', interceptBadge, true);
  document.addEventListener('touchend', interceptBadge, true);

  document.addEventListener('DOMContentLoaded', function () {
    var badge = document.querySelector('#romw_floating_badge_widget .romw-review-panel');
    if (badge) {
      badge.style.cursor = 'pointer';
    }
  });
</script>