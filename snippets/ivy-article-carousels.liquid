{%- comment -%}
  IndyVogue — Article Product Carousels
  Styled to match main-collection PLP carousel exactly.
  Metafields (namespace: custom):
  - carousel_N_collection → Collection reference
  - carousel_N_title      → Single line text (N = 1-5)
  Usage: {%- render 'ivy-article-carousels', article: article, section: section -%}
{%- endcomment -%}

{%- liquid
  assign color_list = 'products.theme_settings.color' | t | downcase | strip | replace: ' ,', ',' | replace: ', ', ',' | split: ',' | uniq
  assign size_list  = 'products.theme_settings.size'  | t | downcase | strip | replace: ' ,', ',' | replace: ', ', ',' | split: ',' | uniq

  assign c1 = article.metafields.custom.carousel_1_collection.value
  assign c2 = article.metafields.custom.carousel_2_collection.value
  assign c3 = article.metafields.custom.carousel_3_collection.value
  assign c4 = article.metafields.custom.carousel_4_collection.value
  assign c5 = article.metafields.custom.carousel_5_collection.value

  assign t1 = article.metafields.custom.carousel_1_title.value
  assign t2 = article.metafields.custom.carousel_2_title.value
  assign t3 = article.metafields.custom.carousel_3_title.value
  assign t4 = article.metafields.custom.carousel_4_title.value
  assign t5 = article.metafields.custom.carousel_5_title.value

  assign col_dk = 4
  assign col_tb = 3
  assign col_mb = 2
  assign space_item = settings.spacing_grid_horizontal
  assign space_item_tb = settings.spacing_grid_horizontal | divided_by: 2
  assign space_item_mb = settings.spacing_grid_horizontal | divided_by: 2
  assign current_width = settings.page_width | append: 'px'
-%}

{%- capture sizes -%}
  (min-width: 1150px) calc(({{ current_width }} - ({{ space_item }} * ({{ col_dk }} - 1))) * 1 / {{ col_dk }}),
  (min-width: 768px) calc((100vw - ({{ space_item_tb }} * ({{ col_tb }} - 1))) * 1 / {{ col_tb }}),
  calc((100vw - ({{ space_item_mb }} * ({{ col_mb }} - 1))) * 1 / {{ col_mb }})
{%- endcapture -%}

{%- capture btn_wishlist_code -%}
  {%- if settings.wishlist_mode != '0' -%}
    {%- render 'btn-wishlist', class: 'hdt-card-product__btn-wishlist hdt-pr_btn', placement: 'right' -%}
  {%- endif -%}
{%- endcapture -%}

{%- for i in (1..5) -%}
  {%- liquid
    case i
      when 1
        assign carousel_collection = c1
        assign carousel_title = t1
      when 2
        assign carousel_collection = c2
        assign carousel_title = t2
      when 3
        assign carousel_collection = c3
        assign carousel_title = t3
      when 4
        assign carousel_collection = c4
        assign carousel_title = t4
      when 5
        assign carousel_collection = c5
        assign carousel_title = t5
    endcase
  -%}

  {%- if carousel_collection != blank -%}
    {%- assign carousel_id = 'ivy-carousel-' | append: article.id | append: '-' | append: i -%}
    {%- assign display_title = carousel_title | default: carousel_collection.title -%}

<div class="ivy-article-carousel hdt-section" style="margin-top: 48px; margin-left: calc(50% - 50vw); margin-right: calc(50% - 50vw); width: 100vw;">
  <div class="hdt-container">

      <div class="hdt-section-heading hdt-text-center" style="margin-bottom: 24px;">
        <h3 class="hdt-heading hdt-font-semibold" style="font-size: 1.25rem; text-transform: uppercase; letter-spacing: 2px;">
          {{ display_title }}
        </h3>
      </div>

      {%- paginate carousel_collection.products by 8 -%}
        <hdt-slider
          id="{{ carousel_id }}"
          class="hdt-collection-products hdt-slider__products hdt-collection-has-pr1 hdt-pr-border_none hdt-ratio--portrait hdt-slider hdt-slider-parent hdt-slide-spacing-x hdt-relative hdt-slider-has-nav lg:hdt-slides-4 md:hdt-slides-3 hdt-slides-2"
          config='{ "id": "{{ carousel_id }}", "navUI": true, "dotUI": false, "navUICenter": true }'>
          <div class="hdt-slider__viewport hdt-relative">
            <div class="hdt-slider__container hdt-equal-height">
              {%- for product in carousel_collection.products -%}
                  {%- unless product.available == false -%}

                {%- assign product_url = product.url | within: carousel_collection -%}
                {%- render 'card-product1',
                  card_product: product,
                  class: 'hdt-slider__slide hdt-pr-style1',
                  section_id: section.id,
                  sizes: sizes,
                  image_ratio: 'portrait',
                  color_list: color_list,
                  size_list: size_list,
                  product_url: product_url,
                  btn_wishlist_code: btn_wishlist_code,
                  show_vendor: false,
                  show_sku: true
                -%}
                  {%- endunless -%}
              {%- endfor -%}
            </div>
          </div>
          <div class="hdt-navigation hdt-position-on_border hdt-visible-always hdt-style-default hdt-shape-default hdt-size-small">
            <button aria-controls="{{ carousel_id }}" class="hdt-slider__button hdt-slider__button--prev" type="button" name="previous" aria-label="previous">
              <svg xmlns="http://www.w3.org/2000/svg" width="7" height="11" viewBox="0 0 7 11" fill="none"><path d="M5.5 11L0 5.5L5.5 0L6.47625 0.97625L1.9525 5.5L6.47625 10.0238L5.5 11Z" fill="currentColor"/></svg>
            </button>
            <button aria-controls="{{ carousel_id }}" class="hdt-slider__button hdt-slider__button--next" type="button" name="next" aria-label="next">
              <svg xmlns="http://www.w3.org/2000/svg" width="7" height="11" viewBox="0 0 7 11" fill="none"><path d="M1.5 11L7 5.5L1.5 0L0.52375 0.97625L5.0475 5.5L0.52375 10.0238L1.5 11Z" fill="currentColor"/></svg>
            </button>
          </div>
        </hdt-slider>

        {%- if paginate.next -%}
          <div class="hdt-text-center" style="margin-top: 24px;">
            <a href="{{ carousel_collection.url }}" class="hdt-btn hdt-btn-outline hdt-btn--size-m hdt-font-medium">
              {{ 'general.pagination.view_all' | t }} {{ carousel_collection.title }}
            </a>
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    </div>{{- '<!-- /hdt-container -->' -}}
</div>{{- '<!-- /ivy-article-carousel -->' -}}
  {%- endif -%}
{%- endfor -%}
