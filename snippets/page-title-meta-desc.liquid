{%- comment -%}
  Replace ONLY the product branch of the TITLE section in
  snippets/page-title-meta-desc.liquid

  Fixes: Shopify's remove_last strips the last occurrence of a substring
  ANYWHERE in the string, not just at the end. `remove_last: ' in'` turned
  "Silk Saree in Yellow" into "Silk Saree Yellow". The sentinel below anchors
  the match to the end of the string.

  Note: inside a {% liquid %} block, comments must use `#`.
  comment/endcomment does not behave as a block comment there.
{%- endcomment -%}

{%- liquid
  # Cut everything from " with " onward - that tail is the long, least
  # distinguishing part of the title.
  assign pt = product.title | split: ' with ' | first | strip
  assign pt_size = pt | size

  # Only truncate if the natural phrase is itself too long.
  if pt_size > 60
    assign pt_words = pt | split: ' '
    assign built = ''
    for w in pt_words
      assign candidate = built | append: w
      assign candidate_size = candidate | size
      if candidate_size > 57
        break
      endif
      assign built = candidate | append: ' '
    endfor
    assign pt = built | strip
  endif

  # Strip a dangling connector, anchored to the END only.
  # The sentinel makes ' in§' matchable only when 'in' is the final word.
  assign pt = pt | append: '§'
  assign pt = pt | replace: ' and§', '§'
  assign pt = pt | replace: ' in§', '§'
  assign pt = pt | replace: ' the§', '§'
  assign pt = pt | replace: ' of§', '§'
  assign pt = pt | replace: ' a§', '§'
  assign pt = pt | replace: ' to§', '§'
  assign pt = pt | replace: ',§', '§'
  assign pt = pt | remove: '§' | strip

  # Append brand only if the whole title still fits in 60 characters.
  assign pt_size = pt | size
  assign brand_size = shop.name | size | plus: 3
  assign total_size = pt_size | plus: brand_size

  if total_size <= 60
    assign product_seo_title = pt | append: ' | ' | append: shop.name
  else
    assign product_seo_title = pt
  endif
-%}
<title>{{ product_seo_title | escape }}</title>
