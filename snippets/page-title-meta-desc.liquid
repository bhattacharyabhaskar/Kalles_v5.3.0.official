{%- comment -%}
  page-title-meta-desc.liquid

  CHANGES FROM PREVIOUS VERSION
  1. Products now respect the SEO title/description set in Shopify admin.
     If nothing is set in admin, output is byte-identical to before
     ("Buy {title} At IndyVogue" + the generated saree description).
  2. Collections now respect the SEO title set in admin (same fallback rule).
  3. Search/wishlist/compare template detection fixed. The old code used
     `template == 'search'`, a strict match that fails whenever a suffix is
     present (search.wish, search.compe). Now uses `template.name`, which
     ignores the suffix. Both old and new suffix spellings are handled.
  4. The `product.type == 'Saree'` description block was running on EVERY
     template, so non-product pages fell into its else branch and got
     shop.description. It is now scoped inside the product branch only.

  HOW THE OVERRIDE WORKS
  We read the metafields directly rather than relying on `page_title`,
  because `page_title` silently falls back to product.title when no SEO
  title is set, which makes "set" and "unset" indistinguishable.
    global.title_tag       = SEO title field in admin
    global.description_tag = SEO meta description field in admin
{%- endcomment -%}

{%- liquid
  assign tpl = template.name
  assign tpl_suffix = template.suffix

  assign seo_title_override = ''
  assign seo_desc_override = ''

  if tpl == 'product'
    assign seo_title_override = product.metafields.global.title_tag
    assign seo_desc_override = product.metafields.global.description_tag
  elsif tpl == 'collection'
    assign seo_title_override = collection.metafields.global.title_tag
    assign seo_desc_override = collection.metafields.global.description_tag
  endif
-%}

{%- if tpl != 'list-collections' -%}

  {%- comment -%} ---------- TITLE ---------- {%- endcomment -%}
  {%- capture seo_title -%}
    {%- if tpl == 'search' and tpl_suffix == blank and search.performed -%}
      {{ 'search.general.heading' | t: count: search.results_count }}: {{ 'search.results_with_count_and_term' | t: terms: search.terms, count: search.results_count }}
    {%- elsif tpl == 'search' and tpl_suffix == blank -%}
      {{ 'search.general.title' | t | default: 'Search' }}
    {%- elsif tpl_suffix == 'wish' or tpl_suffix == 'wishlist' -%}
      {{ 'wishlist_page.meta' | t }}
    {%- elsif tpl_suffix == 'compe' or tpl_suffix == 'compare' -%}
      {{ 'compare_page.meta' | t }}
    {%- else -%}
      {{ page_title }}
    {%- endif -%}
    {%- if current_tags -%}
      {%- assign meta_tags = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags -}}
    {%- endif -%}
    {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{%- endif -%}
    {%- assign escaped_page_title = page_title | escape -%}
    {%- unless escaped_page_title contains shop.name %} &ndash; {{ shop.name }}{%- endunless -%}
  {%- endcapture -%}

  {%- if seo_title_override != blank -%}
    {%- comment -%} Admin SEO title wins, used verbatim. {%- endcomment -%}
    <title>{{ seo_title_override | escape }}</title>
  {%- elsif tpl == 'product' -%}
    {%- comment -%} Unchanged legacy fallback. {%- endcomment -%}
    <title>Buy {{ product.title | escape }} At IndyVogue</title>
  {%- else -%}
    <title>{{ seo_title | strip }}</title>
  {%- endif -%}

  {%- comment -%} ---------- META DESCRIPTION ---------- {%- endcomment -%}
  {%- if seo_desc_override != blank -%}

    <meta name="description" content="{{ seo_desc_override | escape }}">

  {%- elsif tpl == 'product' -%}
    {%- if product.type == 'Saree' and product.metafields.mm-google-shopping.custom_label_0 != blank -%}
      {%- liquid
        assign work_hand = ''
        assign input_arr = product.metafields.saree.new_work | split: ','
        for item in input_arr
          if item contains 'Hand Woven'
            assign work_hand = 'is Hand Woven and '
          endif
        endfor
        assign work_type = product.metafields.saree.new_work | replace: '[', '' | replace: ']', '' | replace: '"', '' | replace: 'Hand Woven,', '' | replace: 'Hand Woven', '' | replace: ',', ', '
      -%}
      {%- if work_type == blank -%}
        <meta name="description" content="Explore {{ product.title | escape }} online and add a touch of elegance to your wardrobe. This {{ product.metafields.mm-google-shopping.custom_label_0 }} saree {{ work_hand }}is perfect for special occasions. Free shipping and easy returns are available!">
      {%- else -%}
        <meta name="description" content="Explore {{ product.title | escape }} online and add a touch of elegance to your wardrobe. This {{ product.metafields.mm-google-shopping.custom_label_0 }} saree {{ work_hand }} features {{ work_type }} and is perfect for special occasions. Free shipping and easy returns are available!">
      {%- endif -%}
    {%- else -%}
      <meta name="description" content="{{ page_description | default: shop.description | default: shop.name | escape }}">
    {%- endif -%}

  {%- else -%}

    <meta name="description" content="{{ page_description | default: shop.description | default: shop.name | escape }}">

  {%- endif -%}

  {%- comment -%} ---------- ROBOTS ---------- {%- endcomment -%}
  {%- if collection.handle == 'all' -%}
    <meta name="robots" content="noindex, follow">
  {%- endif -%}

{%- else -%}

  <title>{{ 'list_collections.meta_title' | t | escape }}</title>
  <meta name="description" content="{{ 'list_collections.meta_description' | t | escape }}">

{%- endif -%}
