{% comment %}
  Saree Cart Cleanup
  Monkey-patches fetch to intercept cart/change.js calls.
  When a saree is removed, bundles addon removal in the same request
  so everything disappears in one single operation with zero lag.
  Works for both cart drawer and main cart page.
{% endcomment %}

<script>
(function () {
  const originalFetch = window.fetch;

  window.fetch = async function (url, options) {

    // Only intercept cart/change.js calls
    if (typeof url === 'string' && url.includes('cart/change.js') && options?.body) {

      try {
        const body = JSON.parse(options.body);
        const lineIndex = body.line;

        if (lineIndex && body.quantity === 0) {
          // Get the cart to find which item is being removed
          const cart = await originalFetch('/cart.js').then(r => r.json());
          const removedItem = cart.items[lineIndex - 1];

          if (removedItem) {
            const removedVariantId = String(removedItem.variant_id);

            // Find any add-ons linked to this item
            const linkedKeys = cart.items
              .filter(item => item.properties?.['Linked to Saree'] == removedVariantId)
              .map(item => item.key);

            if (linkedKeys.length > 0) {
              // Build updates: removed item + all linked addons set to 0
              const updates = { [removedItem.key]: 0 };
              linkedKeys.forEach(key => { updates[key] = 0; });

              // Collect ALL section IDs that need re-rendering
              // Both cart drawer and main cart page
              const sectionIds = [];
              const cartDrawer = document.querySelector('hdt-cart-drawer');
              if (cartDrawer) sectionIds.push(cartDrawer.getAttribute('section-id'));
              const mainCart = document.querySelector('hdt-main-cart');
              if (mainCart) sectionIds.push(mainCart.getAttribute('section-id'));

              // Also pass original sections from body in case Kalles added any
              if (body.sections) {
                const orig = Array.isArray(body.sections) ? body.sections : [body.sections];
                orig.forEach(s => { if (!sectionIds.includes(s)) sectionIds.push(s); });
              }

              const res = await originalFetch('/cart/update.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ updates, sections: sectionIds.join(',') })
              });
              const cartData = await res.json();

              // Return response shaped like cart/change.js so Kalles processes it normally
              return new Response(JSON.stringify(cartData), {
                status: 200,
                headers: { 'Content-Type': 'application/json' }
              });
            }
          }
        }
      } catch (e) {
        console.error('Saree cleanup intercept error:', e);
      }
    }

    // Default: pass through unchanged
    return originalFetch.apply(this, arguments);
  };

})();
</script>
