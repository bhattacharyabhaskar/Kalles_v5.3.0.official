              "blocks": {}
            },
            "text_R8hTbV": {
              "type": "text",
              "settings": {
                "text": "<p>Sumana Bhattacharya holds a Masters in Economics from the University of Calcutta. She started IndyVogue in her garage in 2016. Nine years later, more than 10,000 patrons have shopped with us, and over 700 have left us five-star reviews.'</p><p>Ten thousand women have trusted us with something that matters to them. That's not a number I take lightly.</p><p>We will win your heart.</p>",
                "hidden_br_mobile": false,
                "hidden_on_mobile": false,
                "ffamily": "",
                "text_size": "2xl",
                "line_height": "",
                "font_weight": "normal",
