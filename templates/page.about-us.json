            "difference_heading": {
              "type": "text",
              "settings": {
                "text": "<h6>WHAT MAKES INDYVOGUE DIFFERENT</h6>",
                "hidden_br_mobile": false,
                "hidden_on_mobile": false,
                "ffamily": "",
                "text_size": "2xl",
                "line_height": "",
                "font_weight": "normal",
                "text_color": "hdt-s-text",
                "countdown": "2025-12-30 15:00:00",
                "txt_day": "days",
                "font_size_text_lg": 16,
                "font_size_text": 14,
                "letter_spacing_text": 1
              },
              "blocks": {}
            },
            "difference_spacer": {
              "type": "spacer",
              "settings": {
                "direction": false,
                "space_lg": 14,
                "space_md": 14,
                "space": 12
              },
              "blocks": {}
            },
            "difference_copy": {
              "type": "text",
              "settings": {
                "text": "<p><strong>Every saree is one piece.</strong> We don't restock. When a saree sells, it's gone — and no one else will be wearing it.</p><p><strong>Silk Mark certified.</strong> Our pure silk carries the Silk Mark hologram, issued by the Silk Mark Organisation of India under the Central Silk Board. It's an independent guarantee of pure natural silk, not a claim we make about ourselves.</p><p><strong>Direct from the weavers.</strong> No agents, no wholesale floor. We buy from the families who make the cloth, in Kolkata and across the weaving clusters of India.</p><p><strong>Around 200 new sarees every month.</strong> I am very choosy about what I get.....Baluchari, Banarasi, Kanjeevaram, Jamdani, Tussar, Garad, and more — photographed and described honestly, so what arrives is what you saw.</p>",
                "hidden_br_mobile": false,
                "hidden_on_mobile": false,
                "ffamily": "",
                "text_size": "2xl",
                "line_height": "",
                "font_weight": "normal",
                "text_color": "hdt-text-secondary",
                "countdown": "2025-12-30 15:00:00",
                "txt_day": "days",
                "font_size_text_lg": 16,
                "font_size_text": 14,
                "letter_spacing_text": 0
              },
              "blocks": {}
            }
          },
