              "settings": {
                "text": "<h6>OUR PURPOSE</h6>",
                "hidden_br_mobile": false,
                "hidden_on_mobile": false,
                "ffamily": "",
                "text_size": "2xl",
                "line_height": "",
                "font_weight": "normal",
                "text_color": "hdt-s-text",
                "countdown": "2025-12-30 15:00:00",
                "txt_day": "days",
                "font_size_text_lg": 16,
                "font_size_text": 14,
                "letter_spacing_text": 1
              },
              "blocks": {}
            },
            "purpose_spacer": {
              "type": "spacer",
              "settings": {
                "direction": false,
                "space_lg": 14,
                "space_md": 14,
                "space": 12
              },
              "blocks": {}
            },
            "purpose_copy": {
              "type": "text",
              "settings": {
                "text": "<p>Behind every saree on this site is a loom, and behind the loom is a family. A Baluchari can take a weaver weeks. A Jamdani motif is placed thread by thread, by hand, with no pattern to follow but memory.</p><p>That work is disappearing — younger generations are leaving the looms because the money isn't there. Every saree we buy directly, at a fair price, is a small argument against that.</p><p>This is what a handloom actually looks like.</p>",
                "hidden_br_mobile": false,
                "hidden_on_mobile": false,
                "ffamily": "",
                "text_size": "2xl",
                "line_height": "",
                "font_weight": "normal",
                "text_color": "hdt-text-secondary",
                "countdown": "2025-12-30 15:00:00",
                "txt_day": "days",
                "font_size_text_lg": 16,
                "font_size_text": 14,
                "letter_spacing_text": 0
              },
              "blocks": {}
            }
          },
